<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Черновик карточки текста автора">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="app-body">
  <main class="phone-shell page-shell">
    <header class="page-header">
      <div>
        <p class="eyebrow eyebrow--dark">Текстовый корпус</p>
        <h1>Новая карточка</h1>
      </div>
      <span class="status-chip status-chip--draft">Черновик</span>
    </header>

    <section class="draft-preview" data-video-url="{{authorText.videoUrl}}">
      <img src="{{authorText.imageUrl}}" alt="Обложка: {{authorText.title}}">
      <video muted loop playsinline controls poster="{{authorText.imageUrl}}">
        <source src="{{authorText.videoUrl}}" type="video/webm">
      </video>
    </section>

    <form class="editor-form">
      <label>
        <span>Название</span>
        <input name="authorTextTitle" value="{{authorText.title}}">
      </label>
      <label>
        <span>Автор</span>
        <input name="authorName" value="{{authorText.authorName}}">
      </label>
      <label>
        <span>Год публикации</span>
        <input type="number" name="publicationYear" value="{{authorText.publicationYear}}">
      </label>
      <label>
        <span>URL изображения в MinIO</span>
        <input type="url" name="authorTextImageUrl" value="{{authorText.imageUrl}}">
      </label>
      <label>
        <span>URL видео в MinIO</span>
        <input type="url" name="authorTextVideoUrl" value="{{authorText.videoUrl}}">
      </label>
      <div class="editor-form__split">
        <label>
          <span>Всего токенов</span>
          <input type="number" name="tokenCount" value="{{authorText.tokenCount}}">
        </label>
        <label>
          <span>Уникальных типов</span>
          <input type="number" name="uniqueTypeCount" value="{{authorText.uniqueTypeCount}}">
        </label>
      </div>
      <label>
        <span>Краткое описание</span>
        <textarea name="authorTextExcerpt" rows="4">{{authorText.excerpt}}</textarea>
      </label>
      <button class="primary-button primary-button--wide" type="button">Сохранение будет в лабе №2</button>
    </form>
    {{> bottom_nav}}
  </main>
</body>
</html>
